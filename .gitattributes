# Normalise line endings so Windows and macOS checkouts produce the same diffs
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.wav binary
*.aif binary
*.aiff binary
*.flac binary
*.mp3 binary

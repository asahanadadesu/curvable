# 统一换行符，避免 Windows / macOS 协作时出现无意义的 diff
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.wav binary
*.aif binary
*.aiff binary
*.flac binary
*.mp3 binary
